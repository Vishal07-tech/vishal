# Copy to .env and fill in. Never commit .env.

# Provider: "groq" (Whisper + Qwen on Groq) or "gemini" (Gemini Flash Lite does both).
# Leave blank and the server picks groq when GROQ_API_KEY exists, else gemini.
LLM_PROVIDER=

GROQ_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

API_TOKEN=change-me-to-a-long-random-string
ASR_MODEL=whisper-large-v3-turbo
SUMMARY_MODEL=qwen/qwen3-32b

# Optional: path to a cookies.txt exported from a logged-in browser.
# Needed when YouTube blocks downloads from the host's IP.
YT_COOKIES_FILE=

# Optional overrides
# DB_PATH=./data/app.db
# WORK_ROOT=./data/work
# FFMPEG_PATH=
